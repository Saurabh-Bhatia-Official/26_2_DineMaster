# ==============================================================================
# DineMaster Full-Stack Environment Configuration
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Deployment (Vercel)
# ------------------------------------------------------------------------------
# Production Frontend URL: https://26-2-dine-master.vercel.app/
FRONTEND_URL=https://26-2-dine-master.vercel.app/
APP_MODE=client
APP_ENV=production

# Backend API Configuration for Frontend (Centralized)
# In production, points to Render: https://two6-2-dinemaster.onrender.com
# In local development: http://localhost:8081
API_BASE_URL=https://two6-2-dinemaster.onrender.com
BACKEND_HOST=two6-2-dinemaster.onrender.com
BACKEND_PORT=443

# Standalone Desktop Embedded Server Configuration (Non-Web only)
LOCAL_SERVER_IP=127.0.0.1
LOCAL_SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Backend Deployment (Render)
# ------------------------------------------------------------------------------
# Production Backend URL: https://two6-2-dinemaster.onrender.com
BACKEND_PUBLIC_URL=https://two6-2-dinemaster.onrender.com
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Render / PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinemaster
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password
JPA_DDL_AUTO=update

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://26-2-dine-master.vercel.app,https://26-2-dine-master.vercel.app/,https://two6-2-dinemaster.onrender.com
GUEST_ALLOWED_ORIGIN=https://26-2-dine-master.vercel.app
GUEST_MENU_BASE_URL=https://26-2-dine-master.vercel.app/#/guest-menu

# JWT Authentication
JWT_SECRET=your_base64_or_hex_jwt_secret_key_minimum_256_bits_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Cloudinary Integration (Image & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Integration
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_webhook_secret
