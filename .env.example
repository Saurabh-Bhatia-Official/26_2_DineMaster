# ==============================================================================
# DineMaster Full-Stack Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development:
#    cp .env.example .env
# 2. Configure environment variables in their respective cloud platforms:
#    - Vercel Dashboard -> Settings -> Environment Variables
#    - Render Dashboard -> Environment -> Environment Variables
#    - Neon Database Dashboard -> Connection Details
# ==============================================================================

# ==============================================================================
# 1. VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Production Vercel URL
FRONTEND_URL=https://26-2-dine-master.vercel.app/

# Application Mode:
# 'client' connects to the backend API; 'local' runs standalone embedded SQLite.
APP_MODE=client

# Environment: 'production' | 'development'
APP_ENV=production

# Centralized Backend API Base URL for Frontend:
# - Production (Render Cloud Backend): https://two6-2-dinemaster.onrender.com
# - Localhost Development: http://localhost:8081
API_BASE_URL=https://two6-2-dinemaster.onrender.com
RENDER_API_BASE_URL=https://two6-2-dinemaster.onrender.com
BACKEND_HOST=two6-2-dinemaster.onrender.com
BACKEND_PORT=443

# Standalone Desktop Local Embedded Server (Non-Web only)
LOCAL_SERVER_IP=127.0.0.1
LOCAL_SERVER_PORT=8080

# Vercel Deployment & CI/CD Credentials (GitHub Actions Secrets)
# VERCEL_TOKEN=vcp_your_vercel_api_token
# VERCEL_ORG_ID=team_your_team_id
# VERCEL_PROJECT_ID=prj_your_project_id


# ==============================================================================
# 2. RENDER BACKEND CONFIGURATION
# ==============================================================================
# Production Render Service URL
BACKEND_PUBLIC_URL=https://two6-2-dinemaster.onrender.com

# Server Port (Render injects PORT=10000 automatically)
SERVER_PORT=8081
PORT=8081

# Active Spring Profile: 'prod' for cloud deployment; 'dev' for local
SPRING_PROFILES_ACTIVE=prod

# CORS & Domain Restrictions
CORS_ALLOWED_ORIGINS=https://26-2-dine-master.vercel.app,https://26-2-dine-master.vercel.app/,https://two6-2-dinemaster.onrender.com
GUEST_ALLOWED_ORIGIN=https://26-2-dine-master.vercel.app
GUEST_MENU_BASE_URL=https://26-2-dine-master.vercel.app/#/guest-menu


# ==============================================================================
# 3. NEON / POSTGRESQL CLOUD DATABASE CONFIGURATION
# ==============================================================================
# Method A: Unified Connection URI (Preferred on Render and cloud hosts)
# Supports postgres:// or postgresql:// format, auto-parsed to standard JDBC with SSL:
DATABASE_URL=postgresql://dine_master_owner:your_password@ep-odd-recipe-a7c0q9ag-pooler.ap-southeast-2.aws.neon.tech/dine_master?sslmode=require&channel_binding=require

# Method B: Individual Parameters (Alternative to DATABASE_URL)
DB_HOST=ep-odd-recipe-a7c0q9ag-pooler.ap-southeast-2.aws.neon.tech
DB_PORT=5432
DB_NAME=dine_master
DB_USERNAME=dine_master_owner
DB_PASSWORD=your_secure_password
DB_SSLMODE=require

# JPA & Hibernate Settings
JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false


# ==============================================================================
# 4. SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
# JWT HMAC-SHA256 Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# JWT Token Expiration in Milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Optional: Asymmetric RSA Key Pair (PEM Format)
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=


# ==============================================================================
# 5. CLOUDINARY MEDIA STORAGE
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==============================================================================
# 6. PAYMENT GATEWAY INTEGRATION
# ==============================================================================
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_webhook_secret
