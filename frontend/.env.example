# DineMaster Frontend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Mode: 'local' (standalone SQLite + Shelf) or 'client' (connect to backend / server)
APP_MODE=client

# Production Frontend URL (Vercel)
FRONTEND_URL=https://26-2-dine-master.vercel.app/

# Backend API Configuration (Spring Boot Backend on Render)
API_BASE_URL=http://localhost:8081
BACKEND_HOST=localhost
BACKEND_PORT=8081

# Embedded local server configuration (standalone desktop/LAN mode only)
LOCAL_SERVER_IP=127.0.0.1
LOCAL_SERVER_PORT=8080

# Environment: development | staging | production
APP_ENV=development

# API_BASE_URL=https://two6-2-dinemaster.onrender.com
# BACKEND_HOST=two6-2-dinemaster.onrender.com
# BACKEND_PORT=443
# APP_ENV=production