# ==============================================================================
# DineMaster Spring Boot Backend Environment Configuration
# Copy this file to .env and replace placeholder values with actual secrets.
# DO NOT commit real secrets or .env file to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod
BACKEND_PUBLIC_URL=https://two6-2-dinemaster.onrender.com

# PostgreSQL Database Configuration (Render Postgres or standalone)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinemaster
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password
DB_SSLMODE=prefer
JPA_DDL_AUTO=update
# Optional: Render provides SPRING_DATASOURCE_URL directly
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname

# CORS & Production URL Settings
CORS_ALLOWED_ORIGINS=https://26-2-dine-master.vercel.app,https://26-2-dine-master.vercel.app/,https://two6-2-dinemaster.onrender.com
GUEST_ALLOWED_ORIGIN=https://26-2-dine-master.vercel.app
GUEST_MENU_BASE_URL=https://26-2-dine-master.vercel.app/#/guest-menu

# JWT Authentication (RS256 key pair or minimum 256-bit secret)
JWT_SECRET=your_base64_or_hex_jwt_secret_key_minimum_256_bits_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Cloudinary Integration (Image & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Integration (Kept strictly on backend - Never exposed to frontend)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_webhook_secret
